{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m ruff check .)",
      "Bash(.venv/Scripts/python.exe -m mypy model/ utils/)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/ruff_on_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/agent_prompt_guard.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|ScheduleWakeup|CronCreate|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/stop_latch.py\" --event tool",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/quota_breaker.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/retry_cap_footer.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/shell_edit_guard.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/ruff_on_edit.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/cold_cache_gate.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/stop_latch.py\" --event prompt",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/pre_paste_gate.py\" --event prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/pre_paste_gate.py\" --event stop",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "tokeneconomizer@tokeneconomizer": true
  }
}
