{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m ruff check .)",
      "Bash(.venv/Scripts/python.exe -m mypy model/ utils/)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/ruff_on_edit.py"
          }
        ]
      }
    ]
  }
}
