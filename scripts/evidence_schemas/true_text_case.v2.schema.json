    "after_bbox_visual": {"anyOf": [{"type": "null"},{"$ref": "#/$defs/num4"}]}, "after_bbox_raw": {"anyOf": [{"type": "null"},{"$ref": "#/$defs/num4"}]}, "verify_bbox_visual": {"anyOf": [{"type": "null"},{"$ref": "#/$defs/num4"}]},
    "trm_scale": {"type": "number"}, "user_unit": {"type": "number"},
