{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|collaborationspawn_agent|spawn_agent)$",
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/codex_hook.py PreToolUse", "timeout": 20}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/codex_hook.py PostToolUse", "timeout": 60}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/codex_hook.py UserPromptSubmit", "timeout": 20}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/codex_hook.py Stop", "timeout": 60}
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/codex_hook.py SubagentStart", "timeout": 20}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/codex_hook.py SessionStart", "timeout": 20}
        ]
      }
    ]
  }
}
